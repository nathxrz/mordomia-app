{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "scripts/translate-error.js",
    "scripts/format-date.js",
    "scripts/mask-phone.js",
    "scripts/mask-phone.js",
    "scripts/translate-error.js"
  ]
}
